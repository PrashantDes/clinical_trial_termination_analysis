	partition fact_trials = m
		mode: import
		source =
				let
				  Source = Csv.Document(File.Contents(DataFolder & "fact_trials.csv"), [Delimiter = ",", Columns = 20, Encoding = 65001, QuoteStyle = QuoteStyle.None]),
				  PromotedHeaders = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				  ChangedTypes = Table.TransformColumnTypes(PromotedHeaders, {{"nct_id", type text}, {"brief_title", type text}, {"overall_status", type text}, {"terminated", Int64.Type}, {"phase", type text}, {"enrollment", Int64.Type}, {"enrollment_type", type text}, {"source", type text}, {"source_class", type text}, {"sponsor_group", type text}, {"number_of_arms", Int64.Type}, {"number_of_groups", type text}, {"why_stopped", type text}, {"termination_reason", type text}, {"has_dmc", type text}, {"is_fda_regulated_drug", type text}, {"is_fda_regulated_device", type text}, {"start_year", Int64.Type}, {"start_month", type date}, {"completion_year", Int64.Type}}),
				  TrimmedText = Table.TransformColumns(ChangedTypes, {{"brief_title", each Text.Trim(_), type text}, {"phase", each Text.Trim(_), type text}, {"sponsor_group", each Text.Trim(_), type text}, {"termination_reason", each Text.Trim(_), type text}}),
				  LabelledEnrollmentType = Table.TransformColumns(TrimmedText, {{"enrollment_type", each if _ = null or _ = "" then "Unknown" else _, type text}}),
				  AddedPhaseLabel = Table.AddColumn(LabelledEnrollmentType, "phase_label", each let p = [phase] in if p = "NA" then "Not Applicable" else if p = "EARLY_PHASE1" then "Early Phase 1" else if p = "PHASE1" then "Phase 1" else if p = "PHASE1/PHASE2" then "Phase 1/2" else if p = "PHASE2" then "Phase 2" else if p = "PHASE2/PHASE3" then "Phase 2/3" else if p = "PHASE3" then "Phase 3" else if p = "PHASE4" then "Phase 4" else "Unknown", type text),
				  AddedPhaseOrder = Table.AddColumn(AddedPhaseLabel, "phase_order", each let p = [phase] in if p = "EARLY_PHASE1" then 1 else if p = "PHASE1" then 2 else if p = "PHASE1/PHASE2" then 3 else if p = "PHASE2" then 4 else if p = "PHASE2/PHASE3" then 5 else if p = "PHASE3" then 6 else if p = "PHASE4" then 7 else if p = "NA" then 8 else 9, Int64.Type),
				  AddedEnrollmentBand = Table.AddColumn(AddedPhaseOrder, "enrollment_band", each let e = [enrollment] in if e = null then "Unknown" else if e = 0 then "0" else if e <= 50 then "1-50" else if e <= 200 then "51-200" else if e <= 1000 then "201-1,000" else "1,000+", type text),
				  AddedEnrollmentBandOrder = Table.AddColumn(AddedEnrollmentBand, "enrollment_band_order", each let e = [enrollment] in if e = null then 6 else if e = 0 then 1 else if e <= 50 then 2 else if e <= 200 then 3 else if e <= 1000 then 4 else 5, Int64.Type),
				  AddedEnrollmentOutlier = Table.AddColumn(AddedEnrollmentBandOrder, "enrollment_outlier", each if [enrollment] <> null and [enrollment] > 100000 then 1 else 0, Int64.Type),
				  AddedDmcLabel = Table.AddColumn(AddedEnrollmentOutlier, "has_dmc_label", each if [has_dmc] = "t" then "Yes" else if [has_dmc] = "f" then "No" else "Unknown", type text),
				  AddedFdaDrugLabel = Table.AddColumn(AddedDmcLabel, "fda_drug_label", each if [is_fda_regulated_drug] = "t" then "Yes" else if [is_fda_regulated_drug] = "f" then "No" else "Unknown", type text),
				  AddedFdaDeviceLabel = Table.AddColumn(AddedFdaDrugLabel, "fda_device_label", each if [is_fda_regulated_device] = "t" then "Yes" else if [is_fda_regulated_device] = "f" then "No" else "Unknown", type text),
				  AddedDateCheck = Table.AddColumn(AddedFdaDeviceLabel, "date_check", each if [start_year] = null or [completion_year] = null then "Missing date" else if [completion_year] < [start_year] then "Completion before start" else "Valid", type text)
				in
				  AddedDateCheck

	annotation PBI_ResultType = Table

